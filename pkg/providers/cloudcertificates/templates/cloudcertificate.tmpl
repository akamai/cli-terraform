{{- /*gotype: github.com/akamai/cli-terraform/v3/pkg/providers/cloudcertificates.tfData*/ -}}
terraform {
  required_providers {
    akamai = {
      source  = "akamai/akamai"
      version = ">= 12.0.0"
    }
  }
  required_version = ">= 1.0"
}

provider "akamai" {
  edgerc         = var.edgerc_path
  config_section = var.config_section
}

resource "akamai_cloudcertificates_lineage" "{{ .ResourceName }}" {
  contract_id    = "{{ .Lineage.ContractID }}"
  group_id       = {{ .Lineage.GroupID }}
  geo_class      = "{{ .Lineage.GeoClass }}"
  lineage_name   = "{{ .Lineage.LineageName }}"
  lineage_type   = "{{ .Lineage.LineageType }}"
  secure_network = "{{ .Lineage.SecureNetwork }}"
  key_specs = {
    {{- range .Lineage.KeySpecs }}
    "{{ .KeyType }}" = "{{ .KeySize }}"
    {{- end }}
  }
  sans = [
    {{- range .Lineage.SANs }}
    "{{ . }}",
    {{- end }}
  ]
  {{- with .Lineage.Subject }}
  subject = {
    {{- if .CommonName }}
    common_name         = "{{ .CommonName }}"
    {{- end }}
    {{- if .Organization }}
    organization        = "{{ .Organization }}"
    {{- end }}
    {{- if .OrganizationalUnit }}
    organizational_unit = "{{ .OrganizationalUnit }}"
    {{- end }}
    {{- if .Country }}
    country             = "{{ .Country }}"
    {{- end }}
    {{- if .State }}
    state               = "{{ .State }}"
    {{- end }}
    {{- if .Locality }}
    locality            = "{{ .Locality }}"
    {{- end }}
  }
  {{- end }}
}

{{- if .Upload.IsCommented }}{{ "\n/*\n\n" }}{{ else }}{{ "\n\n" }}{{ end }}resource "akamai_cloudcertificates_upload" "{{ .ResourceName }}" {
  lineage_id = akamai_cloudcertificates_lineage.{{ .ResourceName }}.lineage_id
  {{- if .AcknowledgeWarnings }}
  acknowledge_warnings = true
  {{- end }}
  algorithms = {
    {{- range .Upload.Algorithms }}
    {{- if $.Upload.IsCommented }}
    {{ template "uploadPlaceholderAlgorithm" . }}
    {{- else if .IsCommented }}
    /*
    {{ template "uploadPlaceholderAlgorithm" . }}
    */
    {{- else }}
    "{{ .KeyType }}" = {
      signed_certificate_pem = {{ template "Text" .SignedCertificatePEM }}
      {{- if .TrustChainPEM }}
      trust_chain_pem        = {{ template "Text" .TrustChainPEM }}
      {{- end }}
    }
    {{- end }}
    {{- end }}
  }
}
{{- if .Upload.IsCommented }}
*/
{{- end }}

